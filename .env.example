# ==============================================================================
# Achador de Editais - Configuração de Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com suas credenciais:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️ Banco de Dados (MongoDB)
# ------------------------------------------------------------------------------
# String de conexão com o MongoDB (Atlas ou instância local)
MONGODB_URI="mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/achadordeeditais?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 🤖 Inteligência Artificial (Google Gemini)
# ------------------------------------------------------------------------------
# Chave de API do Google AI Studio para enriquecimento e auditoria de editais
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="sua_chave_gemini_aqui"

# ------------------------------------------------------------------------------
# 📧 Serviço de E-mail (Resend)
# ------------------------------------------------------------------------------
# Chave de API do Resend para disparo de alertas de novos editais e recuperação de senha
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# ------------------------------------------------------------------------------
# 🔐 Segurança e Autenticação (JWT)
# ------------------------------------------------------------------------------
# Segredo criptográfico para assinatura dos tokens JWT de sessão (mínimo de 32 caracteres)
# Gere uma string segura com: openssl rand -hex 32
JWT_SECRET="gere_uma_string_aleatoria_com_mais_de_32_caracteres"

# URL pública da aplicação (usada para gerar links em e-mails de redefinição de senha)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 🏛️ Módulo Federal (Portal da Transparência / IBGE)
# ------------------------------------------------------------------------------
# Chave de API do Portal da Transparência do Governo Federal (módulo IBGE)
# Obtenha em: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY="sua_chave_portal_transparencia_aqui"

# E-mail que receberá os relatórios diários de sincronização e alterações de servidores
ADMIN_NOTIFICATION_EMAIL="admin@exemplo.com"

# ------------------------------------------------------------------------------
# 🛠️ Desenvolvimento e Interface
# ------------------------------------------------------------------------------
# Exibe o painel flutuante de DevTools na interface (true para desenvolvimento, false para produção)
NEXT_PUBLIC_SHOW_DEV_TOOLS=false
